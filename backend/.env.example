# 복사해서 .env 로 이름 바꾼 뒤 값 수정 (.env 는 Git에 올리지 않음)

# MySQL 접속 정보
DATABASE_URL=mysql+pymysql://mes_user:mes_pass@localhost:3306/visionqc_mes?charset=utf8mb4

# 이미지 저장 루트 (로컬 폴더)
STORAGE_DIR=./storage/images
MAX_IMAGE_MB=20

# 로그인 토큰 / 이미지 주소 서명 키 (아무 긴 문자열로 바꾸기)
JWT_SECRET=change-this-secret
JWT_EXPIRE_MINUTES=480
IMAGE_URL_TTL_SECONDS=3600

# 검사 PC 업로드용 키 (inspection/common/mes_client.py 의 api_key 와 같게)
INGEST_API_KEY=change-this-ingest-key

# 프론트엔드 주소 (CORS). 여러 개면 쉼표로
CORS_ORIGINS=http://localhost:5173

# 제품 모델별 3D 기준 치수 [가로, 길이(전폭), 높이] (mm). 검사 PC 가 기준값을 안 보내면 이 값으로 판정
# redcar 는 3D 코드(inspection/station_3d/config.py NOMINAL_MM)와 같은 값
PRODUCT_STANDARDS={"redcar": [194.50, 84.96, 58.68]}
